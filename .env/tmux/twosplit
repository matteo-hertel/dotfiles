# Workspace tmux layouts.
# Layout: claude in the left pane (80%), empty shell in the right pane (20%).

single(){
  tmux has-session -t "$WORKSPACE_SESSION_NAME" 2>/dev/null
  if [ $? != 0 ]
  then
    tmux new-session -d -s "$WORKSPACE_SESSION_NAME" -c "$WORKSPACE_PATH"
    tmux send-keys -t "$WORKSPACE_SESSION_NAME":0 "claude" C-m
  fi
  if [ "$TMUX" = "" ]
  then
    tmux attach -t "$WORKSPACE_SESSION_NAME"
  fi
    tmux switch -t "$WORKSPACE_SESSION_NAME"
}
alias singlevim=single

twosplit(){
  tmux has-session -t "$WORKSPACE_SESSION_NAME" 2>/dev/null
  if [ $? != 0 ]
  then
    tmux new-session -d -s "$WORKSPACE_SESSION_NAME" -c "$WORKSPACE_PATH"
    tmux splitw -t "$WORKSPACE_SESSION_NAME":0 -h -l 20% -c "$WORKSPACE_PATH"
    tmux selectp -t "$WORKSPACE_SESSION_NAME":0.0
    tmux send-keys -t "$WORKSPACE_SESSION_NAME":0.0 "claude" C-m
  fi
  if [ "$TMUX" = "" ]
  then
    tmux attach -t "$WORKSPACE_SESSION_NAME"
  fi
    tmux switch -t "$WORKSPACE_SESSION_NAME"
}

# Same 80/20 split, both panes empty shells.
twosplitNoEditor(){
  tmux has-session -t "$WORKSPACE_SESSION_NAME" 2>/dev/null
  if [ $? != 0 ]
  then
    tmux new-session -d -s "$WORKSPACE_SESSION_NAME" -c "$WORKSPACE_PATH"
    tmux splitw -t "$WORKSPACE_SESSION_NAME":0 -h -l 20% -c "$WORKSPACE_PATH"
    tmux selectp -t "$WORKSPACE_SESSION_NAME":0.0
  fi
  if [ "$TMUX" = "" ]
  then
    tmux attach -t "$WORKSPACE_SESSION_NAME"
  fi
    tmux switch -t "$WORKSPACE_SESSION_NAME"
}
alias twosplitNoClaude=twosplitNoEditor

alias dotfiles="WORKSPACE_SESSION_NAME=dotfiles;WORKSPACE_PATH=~/mhdev/dotfiles;twosplit"
